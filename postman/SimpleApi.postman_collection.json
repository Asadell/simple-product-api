      "name": "01 - Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Username unik tiap run agar tidak bentrok (409).",
                  "const username = 'postman_' + Date.now() + '_' + Math.floor(Math.random() * 1000);",
                  "pm.environment.set('test_username', username);",
                  "if (!pm.environment.get('test_password')) {",
                  "  pm.environment.set('test_password', 'rahasia123');",
                  "}",
                  "console.log('[SimpleApi] Register sebagai ' + username);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = null; }",
                  "",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Response wrapper: success=true', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Message: Registrasi berhasil', () => {",
                  "  pm.expect(body.message).to.eql('Registrasi berhasil');",
                  "});",
                  "",
                  "pm.test('data berisi accessToken dan username', () => {",
                  "  pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.data.username).to.eql(pm.environment.get('test_username'));",
                  "  pm.expect(body.data.expiresAt).to.be.a('string');",
                  "});",
                  "",
                  "if (body && body.data && body.data.accessToken) {",
                  "  pm.environment.set('access_token', body.data.accessToken);",
                  "  console.log('[SimpleApi] access_token tersimpan dari Register');",
                  "}"
                ]
              }
            }
          ],
