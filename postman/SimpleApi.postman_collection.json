          "name": "Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nama produk unik tiap run agar mudah dilacak.",
                  "pm.environment.set('product_name', 'Produk Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = null; }",
                  "",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Response wrapper: success=true', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Message: Produk berhasil dibuat', () => {",
                  "  pm.expect(body.message).to.eql('Produk berhasil dibuat');",
                  "});",
                  "",
                  "pm.test('data.name sesuai yang dikirim', () => {",
                  "  pm.expect(body.data.name).to.eql(pm.environment.get('product_name'));",
                  "});",
                  "",
                  "pm.test('data berisi field ProductResponse lengkap', () => {",
                  "  pm.expect(body.data.id).to.be.a('number');",
                  "  pm.expect(body.data.price).to.eql(150000);",
                  "  pm.expect(body.data.stock).to.eql(20);",
                  "  pm.expect(body.data.description).to.eql('Dibuat dari Postman');",
                  "  pm.expect(body.data.createdAt).to.be.a('string');",
                  "  pm.expect(body.data.updatedAt).to.be.a('string');",
                  "});",
                  "",
                  "// product_id dipakai oleh Get By Id, Update, dan Delete.",
                  "if (body && body.data && body.data.id) {",
                  "  pm.environment.set('product_id', body.data.id);",
                  "  console.log('[SimpleApi] product_id = ' + body.data.id);",
                  "}"
                ]
              }
            }
          ],
